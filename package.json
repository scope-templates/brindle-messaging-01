{
  "name": "brindle-api",
  "version": "2.8.0",
  "private": true,
  "type": "module",
  "description": "Brindle: the transactional messaging API, its store and its scripts",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "seed": "tsx scripts/seed.ts",
    "build-seed": "tsx scripts/build-seed.ts",
    "deliver-webhooks": "tsx scripts/deliver-webhooks.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "5.2.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.5",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
